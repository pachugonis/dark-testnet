# By default, Authorities are not configured as exits
Authority = Node(tag="a", authority=1, relay=1)
ExitRelay = Node(tag="r", relay=1, exit=1)

# arti doesn't use bridge authorities yet, so don't bother.
BridgeAuthority = Node(tag="ba", authority=1, bridgeauthority=1, relay=1)

Bridge = Node(tag="br", bridge=1, relay=1, launch_phase=2)

BridgeClient = Node(
    tag="bc", client=1, bridgeclient=1, backend=NodeBackend.ARTI, launch_phase=3
)

# Since only 25% of relays get the guard flag,
# TestingDirAuthVoteGuard * may need to be used in small networks
# (However, bridge clients use bridges instead of guards, so this
# is only an issue for the exit bootstrapping)

NODES = (
    Authority.getN(4)
    + BridgeAuthority.getN(1)
    + ExitRelay.getN(1)
    + Bridge.getN(1)
    + BridgeClient.getN(1)
)

ConfigureNodes(NODES)
