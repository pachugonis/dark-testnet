    + Node(tag="ct", client=1, launch_phase=2, backend=NodeBackend.TOR).getN(1)
    + Node(tag="ht", hs=1, launch_phase=2, backend=NodeBackend.TOR).getN(1)
    # arti hs client and server
    + Node(tag="ca", client=1, launch_phase=2, backend=NodeBackend.ARTI).getN(1)
    + Node(tag="ha", hs=1, launch_phase=2, backend=NodeBackend.ARTI).getN(1)
)
