# By default, Authorities are not configured as exits
Authority = Node(tag="a", authority=1, relay=1)
ExitRelay = Node(tag="r", relay=1, exit=1)
Client = Node(tag="c", client=1)

BridgeAuthority = Node(tag="ba", authority=1, bridgeauthority=1, relay=1)
Bridge = Node(
    tag="br",
    bridge=1,
    pt_bridge=1,
    relay=1,
    pt_transport="obfs4",
    # incompatible with pt_transport
    sandbox=0,
)
BridgeClient = Node(
    tag="bc",
    client=1,
    bridgeclient=1,
    pt_transport="obfs4",
    config_phase=2,
    launch_phase=2,
    # incompatible with pt_transport
    sandbox=0,
)

NODES = (
    Authority.getN(4)
    + BridgeAuthority.getN(1)
    + ExitRelay.getN(4)
    + Bridge.getN(1)
    + Client.getN(1)
    + BridgeClient.getN(1)
)

ConfigureNodes(NODES)
