# By default, Authorities are not configured as exits
Authority = Node(tag="a", authority=1, relay=1)
ExitRelay = Node(tag="r", relay=1, exit=1)
Client = Node(tag="c", client=1)

BridgeAuthority = Node(tag="ba", authority=1, bridgeauthority=1, relay=1)
Bridge = Node(tag="br", bridge=1, relay=1, launch_phase=2)
HSv3 = Node(tag="h", hs=1, launch_phase=2)
BridgeClient = Node(tag="bc", client=1, bridgeclient=1, launch_phase=3)

# We need 5 authorities/relays/exits to ensure we can build HS connections
NODES = (
    Authority.getN(4)
    + BridgeAuthority.getN(1)
    + ExitRelay.getN(1)
    + Bridge.getN(1)
    + Client.getN(1)
    + BridgeClient.getN(1)
    + HSv3.getN(1)
)

ConfigureNodes(NODES)
